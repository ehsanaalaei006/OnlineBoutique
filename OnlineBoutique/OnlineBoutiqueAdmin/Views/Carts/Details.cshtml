@model OnlineBoutiqueDataLayer.Entities.Cart
@{
    ViewData["Title"] = "Cart Details";
}
<h1>Cart Details</h1>
@if (Model.Items != null && Model.Items.Count > 0)
{
    <table class="table">
        <thead>
            <tr>
                <th>Product Name</th>
                <th>Size</th>
                <th>Unit Price</th>
                <th>Amount</th>
                <th>Total Price</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.ProductName</td>
                    <td>@item.Size</td>
                    <td>@item.UnitPrice</td>
                    <td>@item.Amount</td>
                    <td>@item.TotalPrice</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No items in cart.</p>
}