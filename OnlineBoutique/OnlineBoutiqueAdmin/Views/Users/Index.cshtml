@model IEnumerable<OnlineBoutiqueDataLayer.Entities.User>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Name</td>
                <td>@user.Email</td>
                <td>
                    <form asp-action="Delete" method="post" style="display:inline;">
                        <input type="hidden" name="id" value="@user.Id" />
                        <input type="submit" value="Delete" onclick="return confirm('Are you sure you want to delete this user?');" />
                    </form>

                    <a asp-controller="Carts" asp-action="Details" asp-route-userId="@user.Id" class="btn btn-primary">Show Cart</a>

                </td>
            </tr>
        }
    </tbody>
</table>
