@using OnlineBoutiqueDataLayer.Entities
@model List<Item>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4 product-card mb-4">
            <div class="card product-wap rounded-0 h-100">
                <div class="card rounded-0" onclick="location.href='@Url.Page("/Product", null, new { itemid = item.Id })'" style="cursor:pointer;">
                    <div class="image-container" style="height: 300px; overflow: hidden; display: flex; align-items: center; justify-content: center; background: #f8f9fa;">
                        <img class="card-img rounded-0 img-fluid @(item.QuantityInStock == 0 ? "blur" : "")"
                             src="https://localhost:7049/api/File/GetFile?fileName=@item.ImageUrl"
                             alt="@item.Name"
                             style="width: 100%; height: 100%; object-fit: cover;" />
                    </div>
                    <div class="card-img-overlay rounded-0 product-overlay d-flex align-items-center justify-content-center">
                    </div>
                </div>
                <div class="card-body text-center px-3 py-4">
                    <h5 class="card-title mb-2">
                        <a asp-page="product" asp-route-itemid="@item.Id" class="text-decoration-none text-dark fw-semibold">
                            @item.Name
                        </a>
                    </h5>
                    <p class="mb-1 text-muted small">سایز: <span class="fw-medium">@item.Size</span></p>
                    @if (item.QuantityInStock == 0)
                    {
                        <p class="mb-0 fs-5 text-danger fw-bold">موجود نیست</p>
                    }
                    else
                    {
                        <p class="mb-0 fs-5 text-success fw-bold">@item.Price تومان</p>
                    }
                </div>
            </div>
        </div>
    }
</div>