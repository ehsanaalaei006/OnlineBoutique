@page
@model OnlineBoutique.Pages.CartModel
@{
    ViewData["Title"] = "سبد خرید";
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <style>
        body { background-color: #f8f9fa; }
        .cart-table th, .cart-table td { vertical-align: middle; }
        .cart-summary { background: #fff; border-radius: 10px; padding: 20px; }
    </style>
</head>
<body>
    <div class="container py-5">
        <h2 class="mb-4 text-center">سبد خرید شما</h2>
        @if (Model.Cart.Items != null && Model.Cart.Items.Count > 0)
        {
            <form method="post">
                <table class="table table-bordered cart-table bg-white">
                    <thead class="table-dark">
                        <tr>
                            <th>محصول</th>
                            <th>سایز</th>
                            <th>قیمت واحد</th>
                            <th>تعداد</th>
                            <th>قیمت کل</th>
                            <th>حذف</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Cart.Items)
                        {
                            <tr>
                                <td>@item.ProductName</td>
                                <td>@item.Size</td>
                                <td>@item.UnitPrice.ToString("N0") تومان</td>
                                <td>
                                    <form method="post" asp-page-handler="Update" class="d-inline">
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <input type="hidden" name="size" value="@item.Size" />
                                        <input type="number" name="amount" value="@item.Amount" min="1" style="width:70px;" class="form-control d-inline" />
                                        <button type="submit" class="btn btn-sm btn-primary ms-2">بروزرسانی</button>
                                    </form>
                                </td>
                                <td>@item.TotalPrice.ToString("N0") تومان</td>
                                <td>
                                    <form method="post" asp-page-handler="Delete" class="d-inline">
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <input type="hidden" name="size" value="@item.Size" />
                                        <button type="submit" class="btn btn-sm btn-danger">حذف</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </form>
            <div class="cart-summary mt-4">
                <h5>مجموع سبد خرید: <span class="text-success">@Model.Cart.TotalPrice.ToString("N0") تومان</span></h5>
                <button class="btn btn-success mt-3 w-100">تکمیل خرید</button>
            </div>
        }
        else
        {
            <div class="alert alert-info text-center">سبد خرید شما خالی است.</div>
        }
    </div>
</body>
</html>
