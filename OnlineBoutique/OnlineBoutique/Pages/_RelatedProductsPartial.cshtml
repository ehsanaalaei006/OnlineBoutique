@using OnlineBoutiqueDataLayer.Entities
@model List<Item>
@{
    int itemsPerSlide = 4;
    int slideCount = (int)Math.Ceiling((double)Model.Count / itemsPerSlide);
}
<!-- Include Bootstrap Icons CDN in your _Layout.cshtml head if not already present -->
<!-- <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet"> -->

<style>
    #carousel-related-product .carousel-control-prev,
    #carousel-related-product .carousel-control-next {
        width: 2.5rem;
        height: 2.5rem;
        top: 50%;
        transform: translateY(-50%);
        opacity: 0.7;
        background: rgba(255,255,255,0.85);
        border-radius: 50%;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #198754;
        box-shadow: 0 2px 8px rgba(0,0,0,.08);
    }

    #carousel-related-product .carousel-control-prev {
        left: -2.5rem;
    }

    #carousel-related-product .carousel-control-next {
        right: -2.5rem;
    }

    #carousel-related-product .carousel-control-prev-icon,
    #carousel-related-product .carousel-control-next-icon {
        display: none;
    }

    #carousel-related-product .carousel-control-arrow {
        font-size: 1.4rem;
        color: #198754;
        line-height: 1;
    }

    @@media (max-width: 991.98px) {
        #carousel-related-product .carousel-control-prev {
            left: 0;
        }

        #carousel-related-product .carousel-control-next {
            right: 0;
        }
    }
</style>
<div id="carousel-related-product" class="carousel slide" data-bs-ride="carousel">
    <div class="carousel-inner">
        @for (int i = 0; i < slideCount; i++)
        {
            <div class="carousel-item @(i == 0 ? "active" : "")">
                <div class="row">
                    @for (int j = 0; j < itemsPerSlide; j++)
                    {
                        var index = i * itemsPerSlide + j;
                        if (index >= Model.Count) { break; }
                        var item = Model[index];
                        <div class="col-md-3 product-card mb-3">
                            <div class="card product-wap rounded-0">
                                <div class="card rounded-0" onclick="location.href='@Url.Page("/Product", null, new { itemid = item.Id })'" style="cursor:pointer;">
                                    <img class="card-img rounded-0 img-fluid @(item.QuantityInStock == 0 ? "blur" : "")"
                                         src="https://localhost:7049/api/File/GetFile?fileName=@item.ImageUrl"
                                         alt="@item.Name" />
                                    <div class="card-img-overlay rounded-0 product-overlay d-flex align-items-center justify-content-center">
                                    </div>
                                </div>
                                <div class="card-body text-center px-3 py-4">
                                    <h5 class="card-title mb-2">
                                        <a asp-page="product" asp-route-itemid="@item.Id" class="text-decoration-none text-dark fw-semibold">
                                            @item.Name
                                        </a>
                                    </h5>
                                    <p class="mb-1 text-muted small">سایز: <span class="fw-medium">@item.Size</span></p>
                                    @if (item.QuantityInStock == 0)
                                    {
                                        <p class="mb-0 fs-5 text-danger fw-bold">موجود نیست</p>
                                    }
                                    else
                                    {
                                        <p class="mb-0 fs-5 text-success fw-bold">@item.Price تومان</p>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#carousel-related-product" data-bs-slide="prev">
        <span class="carousel-control-arrow" aria-hidden="true">
            <i class="bi bi-arrow-left"></i>
        </span>
        <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#carousel-related-product" data-bs-slide="next">
        <span class="carousel-control-arrow" aria-hidden="true">
            <i class="bi bi-arrow-right"></i>
        </span>
        <span class="visually-hidden">Next</span>
    </button>
</div>