@page
@model OnlineBoutique.Pages.ProductModel
@{



    <section class="bg-light py-5">
        <div class="container">
            <div class="row g-5 align-items-start">
                <!-- Product Image -->
                <div class="col-lg-5">
                    <div class="card shadow-sm border-0">
                        <img class="card-img-top img-fluid rounded"
                             src="https://localhost:7049/api/File/GetFile?fileName=@Model.item.ImageUrl"
                             alt="@Model.item.Name"
                             id="product-detail">
                    </div>
                </div>

                <!-- Product Info -->
                <div class="col-lg-7">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body">
                            <h2 class="card-title fw-bold mb-3">@Model.item.Name</h2>
                            <p class="h4 text-success mb-4">قیمت: @Model.item.Price تومان</p>

                            <div class="mb-3">
                                <span class="fw-semibold">برند:</span>
                                <span class="text-muted ms-2">پوشاک آسان</span>
                            </div>

                            <div class="mb-3">
                                <span class="fw-semibold">رنگ‌های موجود:</span>
                                <span class="text-muted ms-2">@Model.item.Color</span>
                            </div>

                            <div class="mb-4">
                                <h6 class="fw-semibold">توضیحات محصول:</h6>
                                <p class="text-black">@Model.item.Description</p>
                            </div>

                            <!-- Add to Cart Form -->
                            @if(Model.item.QuantityInStock != 0)
                            {
                                <form method="post" asp-page-handler="AddToCart">
                                    <input type="hidden" name="productId" value="@Model.item.Id" />
                                    <input type="hidden" name="productName" value="@Model.item.Name" />
                                    <input type="hidden" name="unitPrice" value="@Model.item.Price" />

                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label for="product-size" class="form-label fw-semibold">سایز</label>
                                            <select name="productSize" id="product-size" class="form-select">
                                                @foreach (var size in Model.itemSizes)
                                                {
                                                    <option value="@size">@size</option>
                                                }
                                            </select>
                                        </div>

                                        <div class="col-md-6">
                                            <label for="product-quantity" class="form-label fw-semibold">تعداد</label>
                                            <input type="number" name="productQuantity" id="product-quantity"
                                                   class="form-control" value="1" min="1" max="@Model.item.QuantityInStock" />
                                        </div>
                                    </div>

                                    <div class="mt-4">
                                        <button type="submit" class="btn btn-success w-100 py-2">
                                            افزودن به سبد خرید
                                        </button>
                                    </div>
                                </form>
                            }
                            else
                            {
                                <h2 class="text-danger fw-bold align-content-center mb-3">موجود نیست</h2>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Close Content -->
    <!-- Start Article -->
    <section class="py-5">
        <div class="container">
            <div class="row text-left p-2 pb-3">
                <h4>محصولات مرتبط</h4>
            </div>
            <!-- Desktop Carousel -->
            <div class="d-none d-sm-block">
                @await Html.PartialAsync("_RelatedProductsPartial", Model.relatedItems.Take(12).ToList())
            </div>
            <!-- Mobile: show only first 4 products, no carousel -->
            <div class="row d-block d-sm-none">
                @foreach (var item in Model.relatedItems.Take(4))
                {
                    <div class="col-12 mb-3">
                        <div class="card product-wap rounded-0">
                            <div class="card rounded-0"
                                 onclick="location.href='@Url.Page("/Product", null, new { itemid = item.Id })'"
                                 style="cursor:pointer;">
                                <img class="card-img rounded-0 img-fluid @(item.QuantityInStock == 0 ? "blur" : "")"
                                     src="https://localhost:7049/api/File/GetFile?fileName=@item.ImageUrl"
                                     alt="@item.Name" />
                                <div class="card-img-overlay rounded-0 product-overlay d-flex align-items-center justify-content-center">

                                </div>
                            </div>
                            <div class="card-body text-center px-3 py-4">
                                <h5 class="card-title mb-2">
                                    <a asp-page="product" asp-route-itemid="@item.Id" class="text-decoration-none text-dark fw-semibold">
                                        @item.Name
                                    </a>
                                </h5>
                                <p class="mb-1 text-muted small">سایز: <span class="fw-medium">@item.Size</span></p>
                                @if (item.QuantityInStock == 0)
                                {
                                    <p class="mb-0 fs-5 text-danger fw-bold">موجود نیست</p>
                                }
                                else
                                {
                                    <p class="mb-0 fs-5 text-success fw-bold">@item.Price تومان</p>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
    <!-- End Article -->
    <!-- Modal -->
    <div class="modal fade" id="addToCartModal" tabindex="-1" aria-labelledby="addToCartLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content text-center">
                <div class="modal-body">
                    <h5 class="mb-3 text-success">کالا با موفقیت به سبد خرید افزوده شد!</h5>
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal">باشه</button>
                </div>
            </div>
        </div>
    </div>
    @section Scripts {
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
        @if (Model.AddToCartSuccess)
        {
            <script>
                var addToCartModal = new bootstrap.Modal(document.getElementById('addToCartModal'));
                addToCartModal.show();
            </script>
        }
    }


}
