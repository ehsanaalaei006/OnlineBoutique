@page
@model OnlineBoutique.Pages.ProductsModel
@{
    

    <body>
        




        <!-- Start Content -->
        <div class="container py-5">
            <div class="row">

                <div class="col-lg-3">
                    <h1 class="h2 pb-4">دسته بندی</h1>
                    <ul class="list-unstyled">
                        @foreach (var category in Model.Categories)
                        {
                            <li class="mb-3">
                                <a asp-page="/Products" asp-route-categoryid="@category.Id" class="text-decoration-none fw-bold text-dark h5">
                                    @category.Name
                                </a>

                                @if (category.Children != null && category.Children.Any())
                                {
                                    <ul class="list-unstyled ps-4 mt-2">
                                        @foreach (var child in category.Children)
                                        {
                                            <li class="mb-1">
                                                <a asp-page="/Products" asp-route-categoryid="@child.Id" class="text-decoration-none text-muted small">
                                                    @child.Name
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                }
                            </li>
                        }
                    </ul>

                </div>

                <div class="col-lg-9">
                    <div class="row">
                        <div class="col-md-6">
                            <ul class="list-inline shop-top-menu pb-3 pt-1 padd-r-0">
                                <li class="list-inline-item">
                                    <p class="h3 text-dark text-decoration-none mr-3">@Model.CategoryName</p>
                                </li>

                            </ul>
                        </div>
                        
                    </div>
                    <div id="product-grid">
                        @await Html.PartialAsync("_ProductGridPartial", Model.PagedItems)
                    </div>

                    <nav>
                        <ul class="pagination pagination-lg justify-content-center">
                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="#" data-page="@i" data-search="@Model.CurrentSearch" data-category="@Model.CurrentCategoryId">@i</a>
                                </li>
                            }
                        </ul>
                    </nav>



                </div>

            </div>
        </div>
        <!-- End Content -->
        
        
    </body>






}


 <script>
                document.addEventListener('DOMContentLoaded', function () {
            document.addEventListener('click', function (e) {
                const link = e.target.closest('.page-link');
                if (link) {
                    e.preventDefault();

                    const page = link.dataset.page;
                    const categoryId = link.dataset.category;
                    const search = link.dataset.search;
                    fetch(`/Products?handler=ProductGrid&pageId=${page}&categoryId=${categoryId}&q=${search}`)
                        .then(response => response.text())
                        .then(html => {
                            document.getElementById('product-grid').innerHTML = html;
                        });
                }
            });
        });
</script>

